# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）
# 所有变量都是可选的：不配也能跑，只是对应能力停用。

# ---- 员工通讯录 / 域账号登录（MySQL 员工主数据表）----
# 只有配置了 STAFF_DB_HOST 才启用「真人同事」通讯录与域账号登录；
# 不配置时该能力自动停用，AI 成员与其余功能完全不受影响。
STAFF_DB_HOST=
STAFF_DB_PORT=3306
STAFF_DB_USER=
STAFF_DB_PASSWORD=
STAFF_DB_NAME=
STAFF_DB_TABLE=uc_staff

# ---- LLM ----
# 也可在页面「设置」里填写（存本机 data/settings.json，不入库）
DEEPSEEK_API_KEY=
